FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    nftables iptables iproute2 curl ca-certificates procps && rm -rf /var/lib/apt/lists/*
COPY .build/k2r /usr/local/bin/k2r
COPY .build/mocksubs /usr/local/bin/mocksubs
COPY docker-entrypoint-k2r.sh /usr/local/bin/docker-entrypoint-k2r.sh
RUN chmod +x /usr/local/bin/docker-entrypoint-k2r.sh
ENTRYPOINT ["docker-entrypoint-k2r.sh"]
