# Cloud webapp (keep default placeholder, ignore downloaded dist)
cloud/dist/*
!cloud/dist/index.html
!cloud/dist/version.json

# Embedded webapp (built artifact — regenerated by webapp build before go build).
# .gitkeep tracked so fresh clones can build with -tags nowebapp or after webapp build.
# gateway/dist is the legacy location still used by gateway package; webui/dist is
# the shared location consumed by both k2r (gateway) and k2 (daemon) on Linux.
gateway/dist/*
!gateway/dist/.gitkeep
webui/dist/*
!webui/dist/.gitkeep

# Bench artifacts
docker/bench/sing-box
docker/bench/results/
docker/bench/__pycache__/
.worktrees

# Superpowers agent plans (machine-generated, ephemeral)
docs/superpowers/plans/

# Live test environment (hardcoded credentials/IPs)
test/live/

# UAT build artifacts
test/k2r-uat/.build/
rule/embed/krs.tar.gz
